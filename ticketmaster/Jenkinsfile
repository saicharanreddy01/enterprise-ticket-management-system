pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['Development', 'Test', 'Production'],
            description: 'Select the environment'
        )
    }

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    stages {
        stage('Show Environment') {
            steps {
                echo "Selected environment: ${params.ENVIRONMENT}"
            }
        }

        stage('Build Project') {
            steps {
                dir('ticketmaster') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('ticketmaster') {
                    bat 'mvn test'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'ticketmaster/target/surefire-reports/*.xml'
        }
    }
}